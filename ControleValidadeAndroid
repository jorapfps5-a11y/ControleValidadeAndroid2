name: Gerar APK
on:
  workflow_dispatch:
  push:
    branches: [main, master]
jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - run: unzip -q ControleValidadeAndroid.zip
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - run: gradle assembleDebug
        working-directory: ControleValidadeAndroid
      - uses: actions/upload-artifact@v4
        with:
          name: ControleValidade-apk
          path: ControleValidadeAndroid/app/build/outputs/apk/debug/app-debug.apk
